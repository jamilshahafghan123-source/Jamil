# Copy to .env and fill in. Never commit the real .env.

# --- MetaTrader 5 demo account ------------------------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=your-demo-password
MT5_SERVER=MetaQuotes-Demo
# Optional: path to the terminal executable. Leave empty to use the last-used one.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PORTABLE=false
MT5_TIMEOUT_MS=60000
MT5_CONNECT_ON_STARTUP=true

# --- HTTP API -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8443
# Comma-separated. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=change-me
# Comma-separated browser origins allowed to call the API. Empty disables CORS.
CORS_ORIGINS=

# --- TLS ----------------------------------------------------------------------
# python scripts/generate_dev_cert.py --out certs
SSL_CERTFILE=certs/cert.pem
SSL_KEYFILE=certs/key.pem
SSL_KEYFILE_PASSWORD=
# Only set this when a reverse proxy terminates TLS for you.
ALLOW_INSECURE_HTTP=false

# --- Trading guard rails ------------------------------------------------------
# The bridge refuses to trade on non-demo accounts unless this is true.
ALLOW_LIVE_TRADING=false
MAX_VOLUME=1.0

# --- Risk policy --------------------------------------------------------------
# Checked before every order, including dry runs. An order that breaches any of
# these is refused with HTTP 403 risk_rejected and never reaches the terminal.
RISK_ENABLED=true
# Money between entry and stop loss, as a percentage of balance.
RISK_PER_TRADE_PCT=0.5
# Realised + floating loss for the day, as a percentage of the day's opening
# balance. New orders stop once it is reached.
RISK_MAX_DAILY_LOSS_PCT=2.0
RISK_MAX_POSITIONS=2
# Effective lot ceiling is the lower of MAX_VOLUME and RISK_MAX_LOT.
RISK_MAX_LOT=0.10
RISK_REQUIRE_SL=true
RISK_REQUIRE_TP=true
# Comma-separated allowlist for orders. Empty allows every symbol.
RISK_ALLOWED_SYMBOLS=XAUUSD
# Refuse market orders while the spread is wider than this, in points. Broker
# specific: 50 suits XAUUSD on a typical demo server. 0 disables the check.
RISK_MAX_SPREAD_POINTS=50
# Refuse orders whose required margin does not fit in free margin.
RISK_CHECK_MARGIN=true
# Run order_check() before order_send() and refuse on a non-zero retcode.
PREFLIGHT_ORDER_CHECK=true

# --- XAUUSD strategy engine ---------------------------------------------------
# GET /api/v1/signal only analyses and proposes; it never places an order.
# Multi-timeframe: M15 sets the trend, M5 confirms structure and momentum, M1
# supplies the entry trigger. Every read uses closed candles.
STRATEGY_TREND_TIMEFRAME=M15
STRATEGY_STRUCTURE_TIMEFRAME=M5
STRATEGY_TRIGGER_TIMEFRAME=M1
STRATEGY_TREND_CANDLES=300
STRATEGY_STRUCTURE_CANDLES=180
STRATEGY_TRIGGER_CANDLES=120
# 0-100. Below this the engine returns NO_TRADE.
STRATEGY_MIN_SCORE=65
# Stop loss: structure level plus this much ATR, clamped into a sane band.
STRATEGY_SL_ATR_BUFFER=0.5
STRATEGY_SL_MIN_ATR=0.8
STRATEGY_SL_MAX_ATR=3.5
# Take profits as multiples of the risk distance, and which one the order carries.
STRATEGY_TP1_R=1.0
STRATEGY_TP2_R=2.0
STRATEGY_TP3_R=3.0
STRATEGY_ORDER_TP=tp2
# RSI beyond these is over-extended: no fresh entries into it.
STRATEGY_RSI_OVERBOUGHT=75
STRATEGY_RSI_OVERSOLD=25
STRATEGY_TRIGGER_LOOKBACK=8
# Kaufman efficiency ratio below this reads as ranging, not trending.
SIGNAL_MIN_EFFICIENCY=0.25
DEFAULT_DEVIATION=20
DEFAULT_MAGIC=20260816
ORDER_COMMENT_PREFIX=fastapi-bridge

# --- Autonomous bot -----------------------------------------------------------
# Two independent gates. BOT_ENABLED decides whether /bot/start may run at all;
# BOT_DRY_RUN decides whether a running bot may actually send orders. A started
# bot with BOT_DRY_RUN=true records the trades it would have taken and sends
# nothing. Every order it does send goes through the same risk policy,
# order_check pre-flight and demo-account guard as a manual order.
BOT_ENABLED=false
BOT_DRY_RUN=true
# Empty falls back to the first RISK_ALLOWED_SYMBOLS entry / SIGNAL_TIMEFRAME.
BOT_SYMBOL=
BOT_TIMEFRAME=
# "bar" decides once per closed candle; "interval" decides every poll.
BOT_MODE=bar
BOT_POLL_SECONDS=15
# Hard ceiling on trades per day, independent of the risk policy's loss limits.
BOT_MAX_TRADES_PER_DAY=5

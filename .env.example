# Next.js server environment. Copy to .env.local and fill in.
# None of these are NEXT_PUBLIC_*, so they stay on the server and never reach
# the browser bundle.

# Base URL of the FastAPI MT5 bridge (bridge/). Include the scheme and port.
MT5_BRIDGE_URL=https://127.0.0.1:8443

# Same secret as API_KEYS in bridge/.env. Sent as `Authorization: Bearer`.
MT5_BRIDGE_TOKEN=change-me

# Path prefix the bridge serves its trading routes under. The bundled bridge
# uses /api/v1; set to an empty string for a bridge that serves them at the root.
MT5_BRIDGE_API_PREFIX=/api/v1

# Milliseconds before a bridge call is treated as offline.
MT5_BRIDGE_TIMEOUT_MS=10000

# --- TLS to the bridge --------------------------------------------------------
# The bridge's certificate (or its CA) when it is self-signed.
MT5_BRIDGE_CA_CERT=bridge/certs/cert.pem
# Local-development-only alternative: skip verification for bridge calls.
MT5_BRIDGE_INSECURE_TLS=false

# --- Safety -------------------------------------------------------------------
# Master switch for real execution. While this is anything but "true", orders are
# validated against MT5 (order_check) and rejected with HTTP 423 instead of being
# sent, and position closes are refused. Turn it on only after connection,
# account, prices, candles and positions have all been verified.
MT5_ALLOW_LIVE_ORDERS=false

# Copy to .env and fill in. Never commit the real .env.

# --- MetaTrader 5 demo account ------------------------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=your-demo-password
MT5_SERVER=MetaQuotes-Demo
# Optional: path to the terminal executable. Leave empty to use the last-used one.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PORTABLE=false
MT5_TIMEOUT_MS=60000
MT5_CONNECT_ON_STARTUP=true

# --- HTTP API -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8443
# Comma-separated. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=change-me
# Comma-separated browser origins allowed to call the API. Empty disables CORS.
CORS_ORIGINS=

# --- TLS ----------------------------------------------------------------------
# python scripts/generate_dev_cert.py --out certs
SSL_CERTFILE=certs/cert.pem
SSL_KEYFILE=certs/key.pem
SSL_KEYFILE_PASSWORD=
# Only set this when a reverse proxy terminates TLS for you.
ALLOW_INSECURE_HTTP=false

# --- Trading guard rails ------------------------------------------------------
# The bridge refuses to trade on non-demo accounts unless this is true.
ALLOW_LIVE_TRADING=false
MAX_VOLUME=1.0
DEFAULT_DEVIATION=20
DEFAULT_MAGIC=20260816
ORDER_COMMENT_PREFIX=fastapi-bridge

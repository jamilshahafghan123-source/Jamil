# =====================================================================
#  MT5 AI Trading Analyst — environment template
#
#  Copy to .env and fill in.  NEVER commit the filled-in .env.
#  In Google Cloud, put every secret in Secret Manager and surface it to
#  Cloud Run with --set-secrets (see deploy/deploy.sh).
# =====================================================================

# ---- Core -----------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
SYMBOL=XAUUSD

# ---- Database -------------------------------------------------------
# Local docker-compose:
DATABASE_URL=postgresql+asyncpg://mt5ai:mt5ai@db:5432/mt5ai
# Cloud SQL over the Cloud Run socket:
# DATABASE_URL=postgresql+asyncpg://USER:PASS@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE

# ---- Auth -----------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_MINUTES=60

# First user, created only if the users table is empty. Remove after
# the first successful start.
BOOTSTRAP_EMAIL=you@example.com
BOOTSTRAP_PASSWORD=change-this-now

# ---- CORS -----------------------------------------------------------
# Exact origins, comma separated. "*" is rejected when ENV=prod.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ---- MT5 bridge -----------------------------------------------------
# The Windows VM running bridge.py next to the MT5 terminal.
MT5_BRIDGE_URL=http://10.128.0.5:8100
# Must match MT5_BRIDGE_TOKEN on the bridge host. openssl rand -hex 32
MT5_BRIDGE_TOKEN=CHANGE_ME_shared_secret

# ---- REAL MONEY KILL SWITCH -----------------------------------------
# Leave false. Setting it true only *permits* REAL mode to be armed; the
# user must still confirm in the UI, and the bridge has its own latch
# (BRIDGE_ALLOW_REAL) that must also be true.
ALLOW_REAL_TRADING=false

# ---- AI analyst -----------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5
# low | medium | high | xhigh | max — higher costs more and is slower.
ANALYST_EFFORT=medium
BARS_PER_TF=300

# ---- Bot loop -------------------------------------------------------
BOT_INTERVAL_SECONDS=60
MARKET_POLL_SECONDS=2

# ---- Rate limiting --------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# =====================================================================
#  BRIDGE HOST ONLY (set these on the Windows VM, not on Cloud Run)
# =====================================================================
# MT5_LOGIN=12345678
# MT5_PASSWORD=your-demo-password
# MT5_SERVER=YourBroker-Demo
# BRIDGE_HOST=0.0.0.0
# BRIDGE_PORT=8100
# BRIDGE_ALLOW_REAL=false

# ---------------------------------------------------------------------------
# Jamil AI Trading Dashboard - frontend environment
# ---------------------------------------------------------------------------
# The browser NEVER talks to MetaTrader 5 directly.
# Website  ->  Backend API  ->  MT5 Bridge  ->  MetaTrader 5  ->  Demo broker

# Base URL of the Backend API. Leave EMPTY to run on built-in demo/mock data.
VITE_API_BASE_URL=

# Force the demo data source even if VITE_API_BASE_URL is set ("true" / "false").
VITE_FORCE_DEMO_DATA=true

# Optional: dev-server proxy target used for the /api path during `npm run dev`.
VITE_DEV_API_PROXY=http://localhost:8000

# SAFETY: real-money trading is intentionally not implemented in this build.
# Trading controls stay disabled until explicitly configured in a later phase.
VITE_TRADING_ENABLED=false
